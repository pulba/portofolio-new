---
import "../styles/global.css";
import PageLoader from "../components/PageLoader.astro";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Syaiful Bahri - Portfolio",
    description = "Portfolio of Syaiful Bahri, a Freelance Frontend Developer & Graphic Designer specializing in accessible and intuitive digital solutions.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body class="bg-slate-950 text-gray-100 font-sans overflow-x-hidden">
        <PageLoader />
        <slot />
    </body>
</html>
