---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const navLinks = [
    { index: "01", name: "ABOUT", href: "#about" },
    { index: "02", name: "SERVICES", href: "#services" },
    { index: "03", name: "PROJECTS", href: "#projects" },
    { index: "04", name: "SKILLS", href: "#skills" },
    { index: "05", name: "CERTIFICATES", href: "#certificates" },
    { index: "06", name: "CONTACT", href: "#contact" },
];
---

<header
    id="navbar"
    class="fixed top-0 left-0 right-0 z-50 bg-neutral-950/90 backdrop-blur-md hairline-b transition-all duration-200"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <!-- Brand / Logo -->
            <div class="flex items-center gap-3">
                <a href="#hero" class="flex items-center gap-2 group">
                    <span class="w-2.5 h-2.5 bg-rose-600 inline-block transition-transform duration-200 group-hover:scale-125"></span>
                    <span class="font-sans font-bold text-sm tracking-tight text-white uppercase group-hover:text-rose-500 transition-colors">
                        SYAIFUL BAHRI
                    </span>
                </a>
                <span class="text-neutral-600 font-mono text-xs hidden sm:inline">// 2026</span>
            </div>

            <!-- Desktop Navigation -->
            <nav class="hidden lg:flex items-center space-x-1 font-mono text-xs">
                {
                    navLinks.map((link) => (
                        <a
                            href={link.href}
                            class="text-neutral-400 hover:text-white px-3 py-1.5 transition-colors duration-150 hover:bg-neutral-900 rounded-sm"
                        >
                            <span class="text-rose-500 mr-1">{link.index}</span>
                            <span>{link.name}</span>
                        </a>
                    ))
                }
            </nav>

            <!-- Availability indicator -->
            <div class="hidden sm:flex items-center gap-2 font-mono text-xs text-neutral-400">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-[11px] tracking-wider uppercase text-neutral-400">AVAILABLE FOR WORK</span>
            </div>

            <!-- Mobile menu button -->
            <div class="lg:hidden">
                <button
                    id="mobile-menu-btn"
                    type="button"
                    class="p-2 text-neutral-400 hover:text-white focus:outline-none"
                    aria-controls="mobile-menu"
                    aria-expanded="false"
                >
                    <span class="sr-only">Open menu</span>
                    <svg
                        class="block h-5 w-5"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="square"
                            stroke-linejoin="miter"
                            stroke-width="1.5"
                            d="M4 6h16M4 12h16M4 18h16"
                        ></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile menu -->
    <div class="lg:hidden hidden hairline-t bg-neutral-950" id="mobile-menu">
        <div class="px-4 py-4 space-y-2 font-mono text-xs">
            {
                navLinks.map((link) => (
                    <a
                        href={link.href}
                        class="mobile-menu-link flex items-center justify-between text-neutral-300 hover:text-white hover:bg-neutral-900 px-3 py-2.5 rounded-sm transition-colors"
                    >
                        <span>{link.name}</span>
                        <span class="text-rose-500">{link.index}</span>
                    </a>
                ))
            }
        </div>
    </div>
</header>
