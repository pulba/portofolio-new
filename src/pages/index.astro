---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Navbar from "../components/Navbar.astro";

// Import images
import fotoProfile from "../assets/foto-2.webp";
import fotoAbout from "../assets/foto-1.webp";
import projectImage1 from "../assets/image.webp";
import projectImage2 from "../assets/image copy.webp";
import projectImage3 from "../assets/image copy 2.webp";
import certificate1 from "../assets/sertikat.webp";
import certificate2 from "../assets/sertikat2.webp";
import certificate3 from "../assets/sertikat3.webp";
---

<Layout title="Syaiful Bahri - Portfolio">
  <Navbar />

  <!-- Hero Section -->
  <section
    id="hero"
    class="relative py-24 min-h-screen flex items-center justify-center overflow-hidden"
  >
    <!-- Background Effects -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <!-- Animated Gradient Orbs -->
      <div
        class="absolute -top-20 -left-20 w-[500px] h-[500px] bg-gradient-to-br from-teal-500/20 via-cyan-500/10 to-transparent rounded-full blur-3xl animate-float"
      >
      </div>
      <div
        class="absolute top-1/3 -right-32 w-[400px] h-[400px] bg-gradient-to-bl from-blue-500/20 via-indigo-500/10 to-transparent rounded-full blur-3xl animate-float-delayed"
      >
      </div>
      <div
        class="absolute -bottom-32 left-1/3 w-[450px] h-[450px] bg-gradient-to-tr from-purple-500/20 via-pink-500/10 to-transparent rounded-full blur-3xl animate-float-delayed-2"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-r from-teal-500/5 via-blue-500/5 to-purple-500/5 rounded-full blur-3xl"
      >
      </div>

      <!-- Gradient Mesh Overlay -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-slate-950 via-transparent to-slate-950 opacity-60"
      >
      </div>

      <!-- Dot Grid Pattern -->
      <div
        class="absolute inset-0 opacity-20"
        style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.15) 1px, transparent 0); background-size: 32px 32px;"
      >
      </div>

      <!-- Subtle Line Grid -->
      <div
        class="absolute inset-0 opacity-5"
        style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"
      >
      </div>

      <!-- Glow Effect at Center -->
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-96 bg-gradient-to-r from-transparent via-teal-500/10 to-transparent blur-3xl"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 text-center">
      <!-- Profile Image -->
      <div class="mb-8 mt-20 animate-bounce-in">
        <div
          class="w-32 h-32 mx-auto rounded-full overflow-hidden ring-4 ring-teal-500/50 ring-offset-4 ring-offset-slate-950"
        >
          <Image
            src={fotoProfile}
            alt="Syaiful Bahri"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      </div>

      <!-- Name with gradient -->
      <h1 class="text-4xl md:text-7xl font-extrabold mb-4 animate-slide-up">
        <span class="text-gradient">Syaiful Bahri</span>
      </h1>

      <!-- Typing Effect Title -->
      <div class="h-12 mb-6 overflow-hidden animate-slide-up delay-200">
        <h2
          id="typing-text"
          class="text-xl md:text-2xl font-medium text-gray-300"
        >
        </h2>
      </div>

      <!-- Description -->
      <p
        class="text-lg md:text-xl text-gray-400 max-w-2xl mx-auto mb-10 animate-slide-up delay-300"
      >
        Helping you bring digital ideas to life with captivating and functional
        user interfaces, focusing on accessibility and intuitive design.
      </p>

      <!-- CTA Buttons -->
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center animate-slide-up delay-400"
      >
        <a
          href="#projects"
          class="btn-ripple px-8 py-4 bg-gradient-to-r from-teal-500 to-blue-500 rounded-full font-semibold text-white hover:shadow-lg hover:shadow-teal-500/25 transition-all duration-300 transform hover:-translate-y-1"
        >
          View Projects
        </a>
        <a
          href="#contact"
          class="btn-ripple px-8 py-4 border-2 border-teal-500 rounded-full font-semibold text-teal-400 hover:bg-teal-500 hover:text-white transition-all duration-300 transform hover:-translate-y-1"
        >
          Contact Me
        </a>
      </div>
    </div>
  </section>

  <!-- About Me -->
  <section id="about" class="relative py-24 bg-slate-900/50 overflow-hidden">
    <!-- Background Effects -->
    <div class="absolute inset-0 pointer-events-none">
      <div
        class="absolute top-20 right-0 w-96 h-96 bg-gradient-to-br from-blue-500/10 to-purple-500/10 rounded-full blur-3xl animate-float"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-80 h-80 bg-gradient-to-tr from-teal-500/10 to-cyan-500/10 rounded-full blur-3xl animate-float-delayed"
      >
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          About <span class="text-gradient">Me</span>
        </h2>
        <div
          class="w-24 h-1 bg-gradient-to-r from-teal-500 to-blue-500 mx-auto rounded-full"
        >
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <!-- Image -->
        <div class="relative group">
          <div
            class="absolute -inset-4 bg-gradient-to-r from-teal-500 to-blue-500 rounded-2xl blur-lg opacity-25 group-hover:opacity-40 transition-opacity duration-300"
          >
          </div>
          <div class="relative overflow-hidden rounded-2xl h-96">
            <Image
              src={fotoAbout}
              alt="Syaiful Bahri"
              class="w-full h-fit object-cover object-center rounded-2xl transform group-hover:scale-105 transition-transform duration-500"
            />
          </div>
        </div>

        <!-- Content -->
        <div class="space-y-6">
          <div class="glass rounded-2xl p-6">
            <h3 class="text-xl font-semibold text-teal-400 mb-3">👋 Hello!</h3>
            <p class="text-gray-300 leading-relaxed">
              I'm a Freelance Frontend Developer and Graphic Designer with years
              of experience, passionate about creating digital solutions that
              are both beautiful and functional.
            </p>
          </div>

          <div class="glass rounded-2xl p-6">
            <h3 class="text-xl font-semibold text-blue-400 mb-3">
              💡 My Philosophy
            </h3>
            <p class="text-gray-300 leading-relaxed">
              My work philosophy revolves around accessibility, responsive
              design, intuitive UX, and clean code. I excel at translating
              design concepts into structured, maintainable code.
            </p>
          </div>

          <div class="glass rounded-2xl p-6">
            <h3 class="text-xl font-semibold text-purple-400 mb-3">
              🎯 My Goal
            </h3>
            <p class="text-gray-300 leading-relaxed">
              To deliver digital solutions that not only look stunning but also
              perform flawlessly across devices and exceed client expectations.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="relative py-24 overflow-hidden">
    <!-- Background Effects -->
    <div class="absolute inset-0 pointer-events-none">
      <div
        class="absolute -top-24 -left-24 w-96 h-96 bg-gradient-to-br from-teal-500/10 via-cyan-500/5 to-transparent rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute top-1/2 right-0 w-80 h-80 bg-gradient-to-bl from-blue-500/10 via-indigo-500/5 to-transparent rounded-full blur-3xl animate-float-delayed"
      >
      </div>
      <div
        class="absolute bottom-0 left-1/3 w-72 h-72 bg-gradient-to-tr from-purple-500/10 to-transparent rounded-full blur-3xl animate-float"
      >
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          What I <span class="text-gradient">Offer</span>
        </h2>
        <div
          class="w-24 h-1 bg-gradient-to-r from-teal-500 to-blue-500 mx-auto rounded-full"
        >
        </div>
        <p class="mt-4 text-gray-400 max-w-2xl mx-auto">
          Professional services to bring your digital vision to life
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Web Development -->
        <div class="glass rounded-2xl p-8 hover-lift group">
          <div
            class="w-16 h-16 rounded-full bg-teal-500/20 flex items-center justify-center mb-6 group-hover:bg-teal-500/30 transition-colors"
          >
            <svg
              class="w-8 h-8 text-teal-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
              >
              </path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Web Development</h3>
          <p class="text-gray-400 leading-relaxed">
            Building responsive and performant websites using modern frameworks
            like Astro, React, and Tailwind CSS.
          </p>
        </div>

        <!-- UI/UX Design -->
        <div class="glass rounded-2xl p-8 hover-lift group">
          <div
            class="w-16 h-16 rounded-full bg-blue-500/20 flex items-center justify-center mb-6 group-hover:bg-blue-500/30 transition-colors"
          >
            <svg
              class="w-8 h-8 text-blue-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
              >
              </path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">UI/UX Design</h3>
          <p class="text-gray-400 leading-relaxed">
            Creating intuitive and beautiful user interfaces with focus on
            accessibility and user experience.
          </p>
        </div>

        <!-- Graphic Design -->
        <div class="glass rounded-2xl p-8 hover-lift group">
          <div
            class="w-16 h-16 rounded-full bg-purple-500/20 flex items-center justify-center mb-6 group-hover:bg-purple-500/30 transition-colors"
          >
            <svg
              class="w-8 h-8 text-purple-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              >
              </path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Graphic Design</h3>
          <p class="text-gray-400 leading-relaxed">
            Crafting stunning visual designs for branding, marketing materials,
            and digital assets.
          </p>
        </div>

        <!-- Digital Invitations -->
        <div class="glass rounded-2xl p-8 hover-lift group">
          <div
            class="w-16 h-16 rounded-full bg-pink-500/20 flex items-center justify-center mb-6 group-hover:bg-pink-500/30 transition-colors"
          >
            <svg
              class="w-8 h-8 text-pink-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"
              >
              </path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Digital Invitations</h3>
          <p class="text-gray-400 leading-relaxed">
            Specialized in creating beautiful, interactive wedding and event
            invitations.
          </p>
        </div>

        <!-- Frontend Consulting -->
        <div class="glass rounded-2xl p-8 hover-lift group">
          <div
            class="w-16 h-16 rounded-full bg-orange-500/20 flex items-center justify-center mb-6 group-hover:bg-orange-500/30 transition-colors"
          >
            <svg
              class="w-8 h-8 text-orange-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
              >
              </path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Frontend Consulting</h3>
          <p class="text-gray-400 leading-relaxed">
            Expert advice on frontend architecture, performance optimization,
            and best practices.
          </p>
        </div>

        <!-- Maintenance & Support -->
        <div class="glass rounded-2xl p-8 hover-lift group">
          <div
            class="w-16 h-16 rounded-full bg-green-500/20 flex items-center justify-center mb-6 group-hover:bg-green-500/30 transition-colors"
          >
            <svg
              class="w-8 h-8 text-green-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              >
              </path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              >
              </path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">
            Maintenance & Support
          </h3>
          <p class="text-gray-400 leading-relaxed">
            Ongoing website maintenance, updates, and technical support to keep
            your site running smoothly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section id="projects" class="relative py-24 bg-slate-900/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          Featured <span class="text-gradient">Projects</span>
        </h2>
        <div
          class="w-24 h-1 bg-gradient-to-r from-teal-500 to-blue-500 mx-auto rounded-full"
        >
        </div>
        <p class="mt-4 text-gray-400 max-w-2xl mx-auto">
          Some of my recent work that showcases my skills and creativity
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Project 1 -->
        <div
          class="project-card group relative bg-slate-800/50 rounded-2xl overflow-hidden hover-lift"
        >
          <div class="overflow-hidden">
            <Image
              src={projectImage1}
              alt="Digital Wedding Invitations"
              class="w-full h-56 object-cover"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
            >
            </div>
          </div>
          <div class="p-6">
            <div class="flex gap-2 mb-3">
              <span
                class="px-3 py-1 text-xs font-medium bg-teal-500/20 text-teal-400 rounded-full"
                >Astro</span
              >
              <span
                class="px-3 py-1 text-xs font-medium bg-blue-500/20 text-blue-400 rounded-full"
                >Tailwind</span
              >
            </div>
            <h3
              class="text-xl font-bold text-white mb-2 group-hover:text-teal-400 transition-colors"
            >
              Digital Wedding Invitations
            </h3>
            <p class="text-gray-400 mb-4">
              A responsive web application digital wedding invitations.
            </p>
          </div>
        </div>

        <!-- Project 2 -->
        <div
          class="project-card group relative bg-slate-800/50 rounded-2xl overflow-hidden hover-lift"
        >
          <div class="overflow-hidden">
            <Image
              src={projectImage2}
              alt="Sekulah Project"
              class="w-full h-56 object-cover"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
            >
            </div>
          </div>
          <div class="p-6">
            <div class="flex gap-2 mb-3">
              <span
                class="px-3 py-1 text-xs font-medium bg-purple-500/20 text-purple-400 rounded-full"
                >Astro js</span
              >
              <span
                class="px-3 py-1 text-xs font-medium bg-pink-500/20 text-pink-400 rounded-full"
                >Tailwind</span
              >
            </div>
            <h3
              class="text-xl font-bold text-white mb-2 group-hover:text-teal-400 transition-colors"
            >
              Sekulah
            </h3>
            <p class="text-gray-400 mb-4">
              A project for school website integration.
            </p>
          </div>
        </div>

        <!-- Project 3 -->
        <div
          class="project-card group relative bg-slate-800/50 rounded-2xl overflow-hidden hover-lift"
        >
          <div class="overflow-hidden">
            <Image
              src={projectImage3}
              alt="Justic International Law"
              class="w-full h-56 object-cover"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
            >
            </div>
          </div>
          <div class="p-6">
            <div class="flex gap-2 mb-3">
              <span
                class="px-3 py-1 text-xs font-medium bg-orange-500/20 text-orange-400 rounded-full"
                >Astro js</span
              >
              <span
                class="px-3 py-1 text-xs font-medium bg-green-500/20 text-green-400 rounded-full"
                >Tailwind</span
              >
            </div>
            <h3
              class="text-xl font-bold text-white mb-2 group-hover:text-teal-400 transition-colors"
            >
              Justic International Law
            </h3>
            <p class="text-gray-400 mb-4">A web platform Justic Law.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools & Skills -->
  <section id="skills" class="relative py-24 bg-slate-900/50 overflow-hidden">
    <!-- Background Effects -->
    <div class="absolute inset-0 pointer-events-none">
      <div
        class="absolute top-0 left-1/4 w-96 h-96 bg-gradient-to-br from-orange-500/10 to-pink-500/10 rounded-full blur-3xl animate-float"
      >
      </div>
      <div
        class="absolute bottom-20 right-1/4 w-80 h-80 bg-gradient-to-tl from-teal-500/10 to-blue-500/10 rounded-full blur-3xl animate-float-delayed-2"
      >
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          Tools & <span class="text-gradient">Skills</span>
        </h2>
        <div
          class="w-24 h-1 bg-gradient-to-r from-teal-500 to-blue-500 mx-auto rounded-full"
        >
        </div>
        <p class="mt-4 text-gray-400 max-w-2xl mx-auto">
          Technologies and tools I work with daily
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
        <!-- HTML -->
        <div
          class="skill-card glass rounded-2xl p-6 text-center group cursor-pointer"
        >
          <img
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg"
            alt="HTML"
            class="w-14 h-14 mx-auto mb-3 group-hover:scale-110 transition-transform"
          />
          <p class="font-medium text-gray-300">HTML</p>
        </div>

        <!-- CSS -->
        <div
          class="skill-card glass rounded-2xl p-6 text-center group cursor-pointer"
        >
          <img
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/css3/css3-original.svg"
            alt="CSS"
            class="w-14 h-14 mx-auto mb-3 group-hover:scale-110 transition-transform"
          />
          <p class="font-medium text-gray-300">CSS</p>
        </div>

        <!-- JavaScript -->
        <div
          class="skill-card glass rounded-2xl p-6 text-center group cursor-pointer"
        >
          <img
            src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg"
            alt="JavaScript"
            class="w-14 h-14 mx-auto mb-3 group-hover:scale-110 transition-transform"
          />
          <p class="font-medium text-gray-300">JavaScript</p>
        </div>

        <!-- Tailwind -->
        <div
          class="skill-card glass rounded-2xl p-6 text-center group cursor-pointer"
        >
          <img
            src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg"
            alt="Tailwind CSS"
            class="w-14 h-14 mx-auto mb-3 group-hover:scale-110 transition-transform"
          />
          <p class="font-medium text-gray-300">Tailwind</p>
        </div>

        <!-- Astro -->
        <div
          class="skill-card glass rounded-2xl p-6 text-center group cursor-pointer"
        >
