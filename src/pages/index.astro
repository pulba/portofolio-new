---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Navbar from "../components/Navbar.astro";

// Import images
import fotoProfile from "../assets/foto-2.webp";
import fotoAbout from "../assets/foto-1.webp";
import projectImage1 from "../assets/image.webp";
import projectImage2 from "../assets/image copy.webp";
import projectImage3 from "../assets/image copy 2.webp";
import certificate1 from "../assets/sertikat.webp";
import certificate2 from "../assets/sertikat2.webp";
import certificate3 from "../assets/sertikat3.webp";

const services = [
  {
    index: "01",
    title: "Web Development",
    desc: "Building fast, accessible, and responsive websites using modern architectures like Astro and Tailwind CSS.",
    tags: ["Astro", "Tailwind", "JavaScript"]
  },
  {
    index: "02",
    title: "UI/UX Design",
    desc: "Creating intuitive, purposeful interfaces with a strong focus on accessibility, clarity, and user experience.",
    tags: ["Figma", "Design Systems", "Wireframing"]
  },
  {
    index: "03",
    title: "Graphic Design",
    desc: "Crafting distinct visual identities, branding systems, and digital assets that communicate with precision.",
    tags: ["Branding", "Photoshop", "Typography"]
  },
  {
    index: "04",
    title: "Digital Invitations",
    desc: "Interactive, bespoke digital wedding and event invitations engineered for seamless mobile experiences.",
    tags: ["Interactive", "Responsive", "Custom Web"]
  },
  {
    index: "05",
    title: "Frontend Consulting",
    desc: "Codebase reviews, architecture guidance, performance optimization, and modern best practice alignment.",
    tags: ["Code Review", "Optimization", "Audit"]
  },
  {
    index: "06",
    title: "Maintenance & Support",
    desc: "Reliable site monitoring, version upgrades, security fixes, and ongoing content management support.",
    tags: ["Updates", "Security", "SEO"]
  }
];

const projects = [
  {
    index: "01",
    title: "Digital Wedding Invitations",
    desc: "A responsive and interactive web platform engineered for bespoke digital wedding invitations.",
    image: projectImage1,
    tags: ["Astro", "Tailwind", "Interactive"],
    year: "2025"
  },
  {
    index: "02",
    title: "Sekulah",
    desc: "Educational institution platform designed for integrated school communication and student tracking.",
    image: projectImage2,
    tags: ["Astro", "Tailwind", "Platform"],
    year: "2025"
  },
  {
    index: "03",
    title: "Justic International Law",
    desc: "Corporate legal firm web portal emphasizing clarity, trust, and authoritative typography.",
    image: projectImage3,
    tags: ["Astro", "Tailwind", "Corporate"],
    year: "2024"
  }
];

const skills = [
  { name: "HTML5", category: "Core", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg" },
  { name: "CSS3", category: "Core", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/css3/css3-original.svg" },
  { name: "JavaScript", category: "Core", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg" },
  { name: "Tailwind CSS", category: "Framework", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg" },
  { name: "Astro", category: "Framework", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg" },
  { name: "Git", category: "Workflow", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg" },
  { name: "Figma", category: "Design", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/figma/figma-original.svg" },
  { name: "Photoshop", category: "Design", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/photoshop/photoshop-original.svg" }
];

const certificates = [
  { index: "01", title: "Professional Certificate", image: certificate1, category: "Certification" },
  { index: "02", title: "Achievement Award", image: certificate2, category: "Recognition" },
  { index: "03", title: "Excellence Recognition", image: certificate3, category: "Honors" }
];
---

<Layout title="Syaiful Bahri — Frontend Developer & Designer">
  <Navbar />

  <!-- Hero Section (Swiss Editorial Grid) -->
  <section id="hero" class="relative pt-28 pb-20 sm:pt-36 sm:pb-28 hairline-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Top Meta Bar -->
      <div class="flex flex-wrap justify-between items-center gap-4 font-mono text-xs text-neutral-400 uppercase tracking-widest hairline-b pb-6 mb-12">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-rose-600"></span>
          <span>INDEX // VOL. 2026</span>
        </div>
        <div>
          <span>DISCIPLINE: FRONTEND & GRAPHIC DESIGN</span>
        </div>
        <div>
          <span>LOCATION: ID // REMOTE</span>
        </div>
      </div>

      <!-- Main Headline Grid -->
      <div class="grid lg:grid-cols-12 gap-8 items-start mb-16">
        <div class="lg:col-span-8">
          <h1 class="text-6xl sm:text-8xl md:text-9xl font-black tracking-tighter uppercase leading-none text-white mb-6">
            SYAIFUL<br />
            <span class="text-neutral-500">BAHRI</span>
          </h1>

          <div class="flex items-center gap-3 font-mono text-sm text-neutral-400 mb-8">
            <span class="text-rose-500 font-bold">&gt;</span>
            <span class="text-neutral-200">CURRENT FOCUS:</span>
            <span id="typing-text" class="text-white font-medium border-b border-rose-500 pb-0.5"></span>
          </div>

          <p class="text-lg md:text-xl text-neutral-400 max-w-2xl font-normal leading-relaxed mb-10">
            Crafting purposeful, accessible digital interfaces and systematic visual design. 
            Form follows function — no decorative clutter, just structured precision.
          </p>

          <div class="flex flex-wrap gap-4 font-mono text-xs tracking-wider uppercase">
            <a
              href="#projects"
              class="px-6 py-3.5 bg-white text-neutral-950 font-bold hover:bg-rose-600 hover:text-white transition-colors duration-150 inline-flex items-center gap-2"
            >
              <span>VIEW PROJECTS</span>
              <span>&rarr;</span>
            </a>
            <a
              href="#contact"
              class="px-6 py-3.5 hairline text-neutral-300 hover:text-white hover:bg-neutral-900 transition-colors duration-150"
            >
              GET IN TOUCH
            </a>
          </div>
        </div>

        <!-- Hero Portrait in Sharp Rectangular Swiss Frame -->
        <div class="lg:col-span-4 flex justify-center lg:justify-end">
          <div class="relative w-full max-w-xs hairline bg-neutral-900 p-2">
            <div class="aspect-[4/5] overflow-hidden bg-neutral-950">
              <Image
                src={fotoProfile}
                alt="Syaiful Bahri"
                class="w-full h-full object-cover grayscale contrast-125 hover:grayscale-0 transition-all duration-500"
                loading="eager"
              />
            </div>
            <div class="pt-3 pb-1 px-1 flex justify-between items-center font-mono text-[10px] text-neutral-500 uppercase tracking-widest">
              <span>FIG. 01 // PORTRAIT</span>
              <span class="text-rose-500">SYS_VERIFIED</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Ledger / Metric Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 hairline font-mono text-xs divide-x divide-y md:divide-y-0 divide-neutral-800">
        <div class="p-6">
          <span class="text-neutral-500 block mb-1">01 / ROLE</span>
          <span class="text-white font-bold tracking-tight">Frontend Dev & Designer</span>
        </div>
        <div class="p-6">
          <span class="text-neutral-500 block mb-1">02 / CORE STACK</span>
          <span class="text-white font-bold tracking-tight">Astro, Tailwind, JS</span>
        </div>
        <div class="p-6">
          <span class="text-neutral-500 block mb-1">03 / EXPERIENCE</span>
          <span class="text-white font-bold tracking-tight">Multi-Year Practice</span>
        </div>
        <div class="p-6">
          <span class="text-neutral-500 block mb-1">04 / AVAILABILITY</span>
          <span class="text-emerald-400 font-bold tracking-tight flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 bg-emerald-400 inline-block"></span> Open for Contracts
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 01: About (Swiss Asymmetrical Grid) -->
  <section id="about" class="py-24 hairline-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="flex items-baseline justify-between hairline-b pb-6 mb-16">
        <div class="flex items-baseline gap-4">
          <span class="font-mono text-xs text-rose-500 font-bold uppercase tracking-widest">01 //</span>
          <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">About The Craft</h2>
        </div>
        <span class="font-mono text-xs text-neutral-500 uppercase tracking-widest hidden sm:inline">BIOGRAPHY & ETHOS</span>
      </div>

      <div class="grid lg:grid-cols-12 gap-12 items-start">
        <!-- Image with Caption -->
        <div class="lg:col-span-5">
          <div class="hairline bg-neutral-900 p-2">
            <div class="aspect-[4/5] overflow-hidden bg-neutral-950">
              <Image
                src={fotoAbout}
                alt="Syaiful Bahri Studio"
                class="w-full h-full object-cover grayscale contrast-125 hover:grayscale-0 transition-all duration-500"
              />
            </div>
            <div class="pt-3 pb-1 px-1 flex justify-between items-center font-mono text-[10px] text-neutral-500 uppercase tracking-widest">
              <span>FIG. 02 // WORKSPACE</span>
              <span>EST. PERSPECTIVE</span>
            </div>
          </div>
        </div>

        <!-- Editorial Content -->
        <div class="lg:col-span-7 space-y-8">
          <div class="hairline p-8 bg-neutral-900/40">
            <span class="font-mono text-xs text-rose-500 uppercase tracking-widest block mb-3">01 / BACKGROUND</span>
            <h3 class="text-xl font-bold uppercase tracking-tight text-white mb-3">Freelance Developer & Visual Designer</h3>
            <p class="text-neutral-400 leading-relaxed font-normal">
              Based in Indonesia, I work with clients globally to build digital products that balance aesthetic discipline 
              with technical rigor. I specialize in bridging visual design systems with clean, production-ready frontend architectures.
            </p>
          </div>

          <div class="hairline p-8 bg-neutral-900/40">
            <span class="font-mono text-xs text-rose-500 uppercase tracking-widest block mb-3">02 / CORE ETHOS</span>
            <h3 class="text-xl font-bold uppercase tracking-tight text-white mb-3">Accessibility, Performance & Clarity</h3>
            <p class="text-neutral-400 leading-relaxed font-normal">
              Good design is not decorative veneer; it is systematic communication. Every layout is governed by 
              a mathematical grid, deliberate hierarchy, and clean semantic markup that respects user time and attention.
            </p>
          </div>

          <div class="hairline p-8 bg-neutral-900/40">
            <span class="font-mono text-xs text-rose-500 uppercase tracking-widest block mb-3">03 / OBJECTIVE</span>
            <h3 class="text-xl font-bold uppercase tracking-tight text-white mb-3">Execution Without Fluff</h3>
            <p class="text-neutral-400 leading-relaxed font-normal">
              Deliver robust web applications and digital assets that load fast, navigate intuitively, 
              and adapt seamlessly across all viewports and hardware constraints.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 02: Services (Modular Ledger Table) -->
  <section id="services" class="py-24 hairline-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="flex items-baseline justify-between hairline-b pb-6 mb-16">
        <div class="flex items-baseline gap-4">
          <span class="font-mono text-xs text-rose-500 font-bold uppercase tracking-widest">02 //</span>
          <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">Capabilities</h2>
        </div>
        <span class="font-mono text-xs text-neutral-500 uppercase tracking-widest hidden sm:inline">SERVICES ARCHIVE</span>
      </div>

      <!-- Services Grid with Hairline Dividers -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 hairline divide-x divide-y divide-neutral-800">
        {
          services.map((item) => (
            <div class="p-8 hover:bg-neutral-900/60 transition-colors duration-200 flex flex-col justify-between group">
              <div>
                <div class="flex justify-between items-start mb-6">
                  <span class="font-mono text-xs text-rose-500 font-bold">{item.index}</span>
                  <span class="font-mono text-xs text-neutral-600 group-hover:text-white transition-colors">&rarr;</span>
                </div>
                <h3 class="text-xl font-bold uppercase tracking-tight text-white mb-3 group-hover:text-rose-500 transition-colors">
                  {item.title}
                </h3>
                <p class="text-sm text-neutral-400 leading-relaxed font-normal mb-6">
                  {item.desc}
                </p>
              </div>

              <div class="flex flex-wrap gap-1.5 pt-4 hairline-t">
                {item.tags.map((tag) => (
                  <span class="font-mono text-[10px] text-neutral-500 uppercase px-1.5 py-0.5 bg-neutral-900">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 03: Projects (Editorial Gallery) -->
  <section id="projects" class="py-24 hairline-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="flex items-baseline justify-between hairline-b pb-6 mb-16">
        <div class="flex items-baseline gap-4">
          <span class="font-mono text-xs text-rose-500 font-bold uppercase tracking-widest">03 //</span>
          <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">Selected Works</h2>
        </div>
        <span class="font-mono text-xs text-neutral-500 uppercase tracking-widest hidden sm:inline">INDEX 2024-2025</span>
      </div>

      <!-- Project Cards Grid -->
      <div class="grid md:grid-cols-3 gap-8">
        {
          projects.map((proj) => (
            <article class="hairline bg-neutral-900/30 flex flex-col group hover:bg-neutral-900/70 transition-colors duration-200">
              <!-- Image Container -->
              <div class="aspect-[16/10] overflow-hidden bg-neutral-950 hairline-b relative">
                <Image
                  src={proj.image}
                  alt={proj.title}
                  class="w-full h-full object-cover grayscale contrast-110 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500"
                />
                <span class="absolute top-3 right-3 font-mono text-[10px] bg-neutral-950/80 text-neutral-300 px-2 py-1 uppercase tracking-widest hairline">
                  {proj.year}
                </span>
              </div>

              <!-- Metadata & Title -->
              <div class="p-6 flex flex-col flex-grow justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-3">
                    <span class="font-mono text-xs text-rose-500 font-bold">{proj.index}</span>
                    <span class="text-neutral-600 font-mono text-xs">//</span>
                    <span class="font-mono text-xs text-neutral-400 uppercase tracking-wider">WEB APP</span>
                  </div>

                  <h3 class="text-lg font-bold uppercase tracking-tight text-white mb-2 group-hover:text-rose-500 transition-colors">
                    {proj.title}
                  </h3>

                  <p class="text-xs text-neutral-400 leading-relaxed mb-6 font-normal">
                    {proj.desc}
                  </p>
                </div>

                <div class="flex flex-wrap gap-1.5 pt-4 hairline-t">
                  {proj.tags.map((t) => (
                    <span class="font-mono text-[10px] text-neutral-400 uppercase px-2 py-0.5 bg-neutral-900 hairline">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 04: Skills & Tools (Typographic Matrix) -->
  <section id="skills" class="py-24 hairline-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="flex items-baseline justify-between hairline-b pb-6 mb-16">
        <div class="flex items-baseline gap-4">
          <span class="font-mono text-xs text-rose-500 font-bold uppercase tracking-widest">04 //</span>
          <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">Tooling & Stack</h2>
        </div>
        <span class="font-mono text-xs text-neutral-500 uppercase tracking-widest hidden sm:inline">TECHNICAL MATRIX</span>
      </div>

      <!-- Skills Matrix Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 hairline divide-x divide-y divide-neutral-800">
        {
          skills.map((s, idx) => (
            <div class="p-6 hover:bg-neutral-900/60 transition-colors duration-200 group">
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-[10px] text-rose-500">{(idx + 1 < 10 ? "0" : "") + (idx + 1)}</span>
                <span class="font-mono text-[10px] text-neutral-500 uppercase tracking-widest">{s.category}</span>
              </div>
              <div class="w-10 h-10 mb-4 filter grayscale group-hover:grayscale-0 transition-all duration-200">
                <img src={s.icon} alt={s.name} class="w-full h-full object-contain" />
              </div>
              <h3 class="font-mono text-sm font-bold text-white group-hover:text-rose-500 transition-colors uppercase tracking-tight">
                {s.name}
              </h3>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 05: Certificates (Registry Format) -->
  <section id="certificates" class="py-24 hairline-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="flex items-baseline justify-between hairline-b pb-6 mb-16">
        <div class="flex items-baseline gap-4">
          <span class="font-mono text-xs text-rose-500 font-bold uppercase tracking-widest">05 //</span>
          <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">Certifications</h2>
        </div>
        <span class="font-mono text-xs text-neutral-500 uppercase tracking-widest hidden sm:inline">VERIFIED ACCREDITATION</span>
      </div>

      <!-- Certificate Grid -->
      <div class="grid md:grid-cols-3 gap-8">
        {
          certificates.map((cert) => (
            <div class="hairline bg-neutral-900/30 p-2 group hover:bg-neutral-900/60 transition-colors duration-200">
              <div class="aspect-[4/3] overflow-hidden bg-neutral-950 mb-3">
                <Image
                  src={cert.image}
                  alt={cert.title}
                  class="w-full h-full object-cover grayscale contrast-110 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500"
                />
              </div>
              <div class="p-3">
                <div class="flex justify-between items-center font-mono text-[10px] text-neutral-500 uppercase tracking-widest mb-1.5">
                  <span class="text-rose-500 font-bold">{cert.index} // VERIFIED</span>
                  <span>{cert.category}</span>
                </div>
                <h3 class="font-mono text-xs font-bold text-white uppercase tracking-tight group-hover:text-rose-500 transition-colors">
                  {cert.title}
                </h3>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 06: Contact (Swiss Poster Layout) -->
  <section id="contact" class="py-24 hairline-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="flex items-baseline justify-between hairline-b pb-6 mb-16">
        <div class="flex items-baseline gap-4">
          <span class="font-mono text-xs text-rose-500 font-bold uppercase tracking-widest">06 //</span>
          <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">Initiate Contact</h2>
        </div>
        <span class="font-mono text-xs text-neutral-500 uppercase tracking-widest hidden sm:inline">COMMUNICATION DIRECTORY</span>
      </div>

      <div class="grid lg:grid-cols-12 gap-12 items-start">
        <!-- Giant Typography Left -->
        <div class="lg:col-span-6">
          <h3 class="text-4xl sm:text-6xl font-black uppercase tracking-tighter text-white leading-tight mb-6">
            HAVE A PROJECT?<br />
            <span class="text-rose-600">LET'S BUILD IT</span><br />
            TOGETHER.
          </h3>
          <p class="text-neutral-400 font-normal leading-relaxed max-w-md mb-8">
            Available for freelance commissions, technical consulting, and frontend engineering contracts. 
            Direct responses within 24 hours.
          </p>

          <div class="font-mono text-xs text-neutral-500 space-y-2">
            <div>TIMEZONE: UTC+07:00 (WIB)</div>
            <div>LANGUAGES: INDONESIAN, ENGLISH</div>
          </div>
        </div>

        <!-- Directory Ledger Right -->
        <div class="lg:col-span-6 hairline divide-y divide-neutral-800 font-mono text-xs">
          <!-- Email -->
          <a
            href="mailto:sb529447@gmail.com"
            class="flex justify-between items-center p-6 hover:bg-neutral-900 group transition-colors"
          >
            <div>
              <span class="text-rose-500 block mb-1">01 // EMAIL</span>
              <span class="text-sm font-bold text-white group-hover:text-rose-500 transition-colors">sb529447@gmail.com</span>
            </div>
            <span class="text-neutral-500 group-hover:text-white transition-colors">&rarr;</span>
          </a>

          <!-- WhatsApp -->
          <a
            href="https://wa.me/+6285840294989"
            target="_blank"
            class="flex justify-between items-center p-6 hover:bg-neutral-900 group transition-colors"
          >
            <div>
              <span class="text-emerald-400 block mb-1">02 // WHATSAPP</span>
              <span class="text-sm font-bold text-white group-hover:text-emerald-400 transition-colors">+628 5840 294989</span>
            </div>
            <span class="text-neutral-500 group-hover:text-white transition-colors">&rarr;</span>
          </a>

          <!-- GitHub -->
          <a
            href="https://github.com/pulba"
            target="_blank"
            class="flex justify-between items-center p-6 hover:bg-neutral-900 group transition-colors"
          >
            <div>
              <span class="text-neutral-400 block mb-1">03 // GITHUB</span>
              <span class="text-sm font-bold text-white group-hover:text-white transition-colors">github.com/pulba</span>
            </div>
            <span class="text-neutral-500 group-hover:text-white transition-colors">&rarr;</span>
          </a>

          <!-- Instagram -->
          <a
            href="https://instagram.com/bang_usia"
            target="_blank"
            class="flex justify-between items-center p-6 hover:bg-neutral-900 group transition-colors"
          >
            <div>
              <span class="text-neutral-400 block mb-1">04 // INSTAGRAM</span>
              <span class="text-sm font-bold text-white group-hover:text-white transition-colors">@bang_usia</span>
            </div>
            <span class="text-neutral-500 group-hover:text-white transition-colors">&rarr;</span>
          </a>

          <!-- Facebook -->
          <a
            href="https://facebook.com/bangusia"
            target="_blank"
            class="flex justify-between items-center p-6 hover:bg-neutral-900 group transition-colors"
          >
            <div>
              <span class="text-neutral-400 block mb-1">05 // FACEBOOK</span>
              <span class="text-sm font-bold text-white group-hover:text-white transition-colors">bangusia</span>
            </div>
            <span class="text-neutral-500 group-hover:text-white transition-colors">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-12 bg-neutral-950 font-mono text-xs text-neutral-500">
